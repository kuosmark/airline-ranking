  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@eslint/js": "10.0.1",
    "angular-eslint": "21.4.0",
    "eslint": "10.12.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.71.0"
