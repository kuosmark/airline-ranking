{
  "name": "airline-ranking",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "ng serve --host 127.0.0.1",
    "backend": "node --env-file=.env --experimental-strip-types backend/main.ts",
    "build": "ng build",
    "lint": "eslint src shared backend infra tests --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck:backend": "tsc -p backend/tsconfig.json",
    "check": "npm run lint && npm run typecheck:backend && npm run typecheck:infra && npm test && npm run build && npm run infra:synth",
    "typecheck:infra": "tsc -p infra/tsconfig.json",
    "infra:synth": "cdk synth --strict --no-lookups",
    "infra:diff": "cdk diff",
    "infra:deploy": "cdk deploy",
    "infra:publish": "node --experimental-strip-types infra/publish.ts",
    "infra:release": "node --experimental-strip-types infra/release.ts"
  },
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/client-ssm": "^3.1146.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@aws-sdk/client-cloudfront": "^3.1146.0",
    "@aws-sdk/client-lambda": "^3.1146.0",
    "@eslint/js": "10.0.1",
    "@types/node": "^22.20.5",
    "angular-eslint": "21.4.0",
    "aws-cdk": "^2.1144.0",
    "aws-cdk-lib": "^2.272.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "eslint": "10.12.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.71.0"
  }
}
